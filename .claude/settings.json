{
  "$comment": "Project harness config. `permissions` pre-allows safe, repetitive dev commands so approval fatigue doesn't set in, while keeping destructive ops gated. `hooks` is the enforcement layer — see docs/HARNESS.md for what each one exists for. Real secrets live in .env (gitignored), never here.",
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm add:*)",
      "Bash(pnpm --filter:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm db:migrate:*)",
      "Bash(pnpm db:seed:*)",
      "Bash(pnpm dev:*)",
      "Bash(npx drizzle-kit:*)",
      "Bash(docker compose up:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(vitest:*)",
      "Bash(bash testing/harness_hooks.sh)",
      "Bash(bash testing/:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout -b:*)",
      "Bash(curl -s http://localhost:*)",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep"
    ],
    "deny": [
      "Bash(docker compose down -v:*)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(drizzle-kit drop:*)",
      "Bash(psql* DROP*)"
    ]
  },
  "$hooksComment": "Node rather than shell so the same files run on a Windows dev box and on the ubuntu-latest runner in .github/workflows/agent-issue-to-pr.yml. One guardrail definition, two execution contexts. Every hook fails open on malformed input — a guard that crashes closed would deny every subsequent tool call in the session.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/session-brief.mjs"],
            "timeout": 15,
            "statusMessage": "Loading session brief"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-write.mjs"],
            "timeout": 15,
            "statusMessage": "Checking write target"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-bash.mjs"],
            "timeout": 15,
            "statusMessage": "Checking command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/scan-secrets.mjs"],
            "timeout": 15,
            "statusMessage": "Scanning for credentials"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/record-bash.mjs"],
            "timeout": 15,
            "statusMessage": "Recording test outcome"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/gate-turn.mjs"],
            "timeout": 30,
            "statusMessage": "Running end-of-turn gates"
          }
        ]
      }
    ]
  },
  "env": {
    "$comment": "Non-secret defaults. MEMOS_DIFF_BUDGET_* tune the Stop-hook diff budget; CI sets stricter values in the workflow.",
    "MEMOS_LOG_LEVEL": "debug"
  }
}
